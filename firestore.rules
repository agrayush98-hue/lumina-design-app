rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function ownsDoc() { return isAuth() && request.auth.uid == resource.data.userId; }
    match /projects/{projectId} {
      allow read:   if ownsDoc() || resource.data.isShared == true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if ownsDoc();
      allow delete: if ownsDoc();
    }
    match /users/{userId} {
      allow read:   if isAuth() && request.auth.uid == userId;
      allow create: if isAuth() && request.auth.uid == userId
              && request.resource.data.subscription.status == 'trial'
              && request.resource.data.subscription.plan == 'trial';
      allow update: if isAuth() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
